{
  "name": "mfe-identity",
  "private": true,
  "version": "1.9.0",
  "engines": {
    "node": ">=22.22"
  },
  "description": "A Commerce Layer Single Page Application to provide login and signup.",
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/mfe-identity.git"
  },
  "author": {
    "name": "Pier Francesco Ferrari",
    "email": "pierfrancesco@commercelayer.io"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/commercelayer/mfe-identity/issues"
  },
  "homepage": "https://github.com/commercelayer/mfe-identity#readme",
  "keywords": [
    "reactjs",
    "jamstack",
    "headless",
    "ecommerce",
    "identity",
    "login",
    "signup",
    "commercelayer"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "vite --host 0.0.0.0 --port $PORT preview",
    "preview": "vite preview",
    "check": "pnpm biome check",
    "check:fix": "pnpm biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "touch ./public/config.local.js"
  },
  "dependencies": {
    "@commercelayer/js-auth": "^8.0.1",
    "@commercelayer/sdk": "^8.0.2",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "v2.1.10",
    "classnames": "^2.5.1",
    "i18next": "^26.4.2",
    "lodash": "^4.18.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-helmet-async": "3.0.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "^17.0.16",
    "wouter": "^3.13.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/iframe-resizer": "^4.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-helmet": "6.1.11",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.6",
    "jsdom": "^30.1.2",
    "only-allow": "^1.2.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
